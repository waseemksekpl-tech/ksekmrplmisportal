rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Auth helper
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'waseemksekpl@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'super_admin')
      );
    }
    
    function isMISAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'mis_admin'
      );
    }
    
    function isManager() {
      return isMISAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'manager'
      );
    }
    
    function isCompanyEmployee() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Users collection:
    // Read: authenticated users can read profiles for directory/author display; user can read own
    // Write: super admins can manage any user; users can initialize/update their own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Reports:
    // Read: Employees/Managers/Admins based on access level
    // Write: Super Admin and MIS Admin
    match /reports/{reportId} {
      allow read: if isCompanyEmployee();
      allow create, update: if isMISAdmin();
      allow delete: if isSuperAdmin();
    }

    // Announcements:
    // Read: All authenticated employees
    // Write: Super Admin and MIS Admin
    match /announcements/{announcementId} {
      allow read: if isCompanyEmployee();
      allow create, update: if isMISAdmin();
      allow delete: if isSuperAdmin();
    }

    // Documents:
    // Read: Company employees
    // Write: MIS Admin and Super Admin
    match /documents/{documentId} {
      allow read: if isCompanyEmployee();
      allow create, update: if isMISAdmin();
      allow delete: if isSuperAdmin();
    }

    // Sales:
    // Read: Company employees (Managers and above can see sensitive metrics; employees see authorized list)
    // Write: MIS Admin and Super Admin
    match /sales/{saleId} {
      allow read: if isCompanyEmployee();
      allow create, update: if isMISAdmin();
      allow delete: if isSuperAdmin();
    }

    // Inventory:
    // Read: Company employees
    // Write: MIS Admin, Super Admin (Stock updates allowed for logistics managers)
    match /inventory/{itemId} {
      allow read: if isCompanyEmployee();
      allow create, update: if isMISAdmin();
      allow delete: if isSuperAdmin();
    }

    // Dispatches:
    // Read: Company employees
    // Write: MIS Admin and Super Admin
    match /dispatches/{dispatchId} {
      allow read: if isCompanyEmployee();
      allow create, update: if isMISAdmin() || isManager();
      allow delete: if isSuperAdmin();
    }

    // Partners:
    // Read: Company employees
    // Write: MIS Admin and Super Admin
    match /partners/{partnerId} {
      allow read: if isCompanyEmployee();
      allow create, update: if isMISAdmin();
      allow delete: if isSuperAdmin();
    }

    // Activity Logs:
    // Read: Super Admin and MIS Admin
    // Create: Any authenticated user logging an action
    // Update/Delete: Super Admin only
    match /activityLogs/{logId} {
      allow read: if isMISAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Notifications:
    // Read & Update: The recipient user or Super Admin
    // Create: Any authenticated user (e.g. system alerts generated by MIS actions)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientUid == 'all' || isSuperAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isSuperAdmin());
      allow delete: if isSuperAdmin() || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
    }
  }
}
